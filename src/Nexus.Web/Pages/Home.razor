@page "/"
@inject AuditSession Session

<PageTitle>Nexus</PageTitle>

@if (Session.HasResult && !busy)
{
    <Dashboard OnReset="Reset" />
}
else
{
    <section class="intro">
        <div class="intro-copy">
            <h1>Inspeção de acesso na cooperativa @AuditScope.Coop</h1>
            <p>
                Cruze a planilha de atividades, diária ou mensal, com a lista de autorizados e identifique
                cada atividade feita por um usuário sem permissão para atuar na coop @AuditScope.Coop.
            </p>
        </div>
        <LogoMark Size="220" Tile="false" Class="intro-mark" />
    </section>

    <section class="intake">
        <div class="drops">
            <div class="drop @(dragA ? "drag" : "") @(activityFiles.Count > 0 ? "filled" : "")"
                 @ondragenter="() => dragA = true" @ondragleave="() => dragA = false" @ondrop="() => dragA = false">
                <InputFile OnChange="OnActivityFiles" multiple accept=".xlsx" aria-label="Planilha de atividades" />
                <div class="drop-icon">
                    <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="4" width="16" height="16" rx="2" /><path d="M4 9h16M4 14h16M10 4v16" /></svg>
                </div>
                <div class="drop-body">
                    <div class="drop-title">Planilha de atividades</div>
                    @if (activityFiles.Count == 0)
                    {
                        <div class="drop-sub">Diária ou mensal, no layout do compilado. Para juntar vários dias, selecione todos os arquivos juntos.</div>
                        <div class="drop-cta">Arraste o .xlsx ou clique para escolher</div>
                    }
                    else
                    {
                        <ul class="file-list">
                            @foreach (var f in activityFiles)
                            {
                                <li><StatusIcon Status="AccessStatus.Autorizado" /> <span class="fname">@f.Name</span> <span class="muted">@AuditSession.FormatBytes(f.Size)</span></li>
                            }
                        </ul>
                        <div class="drop-cta subtle">Clique para trocar</div>
                    }
                </div>
            </div>

            <div class="drop @(dragU ? "drag" : "") @(usersFile != null ? "filled" : "")"
                 @ondragenter="() => dragU = true" @ondragleave="() => dragU = false" @ondrop="() => dragU = false">
                <InputFile OnChange="OnUsersFile" accept=".xlsx" aria-label="Lista de autorizados" />
                <div class="drop-icon">
                    <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="8" r="3.2" /><path d="M3 19c.8-3.2 3.2-5 6-5s5.2 1.8 6 5" /><path d="M16 11l2 2 3.5-3.5" /></svg>
                </div>
                <div class="drop-body">
                    <div class="drop-title">Lista de autorizados</div>
                    @if (usersFile == null)
                    {
                        <div class="drop-sub">Aba <code>@(AuditScope.Coop)_autorizados</code>, com um login por linha.</div>
                        <div class="drop-cta">Arraste o .xlsx ou clique para escolher</div>
                        <a class="drop-link" href="modelos/usuarios_modelo.xlsx" download @onclick:stopPropagation="true">Baixar modelo da lista</a>
                    }
                    else
                    {
                        <ul class="file-list">
                            <li><StatusIcon Status="AccessStatus.Autorizado" /> <span class="fname">@usersFile.Name</span> <span class="muted">@AuditSession.FormatBytes(usersFile.Size)</span></li>
                        </ul>
                        <div class="drop-cta subtle">Clique para trocar</div>
                    }
                </div>
            </div>
        </div>

        <div class="intake-foot">
            <div>
                <div class="field-label">A atividade pertence à cooperativa pela</div>
                <div class="segmented">
                    @foreach (var m in Enum.GetValues<CoopMatchMode>())
                    {
                        <button class="@(mode == m ? "on" : "")" @onclick="() => mode = m">@Fmt.ModeLabel(m)</button>
                    }
                </div>
            </div>
            <div class="intake-action">
                @if (error != null)
                {
                    <div class="error-box" role="alert">
                        <strong>Não foi possível analisar.</strong> @error
                    </div>
                }
                <button class="btn primary big" disabled="@(!CanAnalyze)" @onclick="Analyze">Analisar planilhas</button>
                @if (!CanAnalyze && !busy)
                {
                    <div class="field-help">@(activityFiles.Count == 0 && usersFile == null ? "Escolha as duas planilhas para começar." : activityFiles.Count == 0 ? "Falta a planilha de atividades." : "Falta a lista de autorizados.")</div>
                }
            </div>
        </div>
    </section>

    <section class="rules">
        <h2>Como montar a lista de autorizados</h2>
        <div class="rules-grid">
            <div class="rule">
                <div class="tabs-demo">
                    <span class="on">@(AuditScope.Coop)_autorizados</span>
                </div>
                <p><strong>Uma aba chamada @(AuditScope.Coop)_autorizados.</strong> Na coluna A, um login por linha, como aparece na coluna USUARIO. Maiúsculas e acentos não importam.</p>
            </div>
            <div class="rule">
                <div class="rule-badges">
                    <span class="badge ok"><StatusIcon Status="AccessStatus.Autorizado" /> Autorizado</span>
                    <span class="badge bad"><StatusIcon Status="AccessStatus.NaoAutorizado" /> Não autorizado</span>
                </div>
                <p><strong>Só quem está na aba pode atuar.</strong> Qualquer outro usuário com volume na coop @AuditScope.Coop é não autorizado. Uma aba vazia significa que ninguém está liberado.</p>
            </div>
            <div class="rule">
                <div class="rule-cols"><span>COOPERATIVA</span><span>USUARIO</span><span>STATUS</span></div>
                <p><strong>Também vale uma aba única</strong> com essas três colunas e o status <em>Autorizado</em>. Linhas e abas de outras cooperativas são ignoradas.</p>
            </div>
        </div>
    </section>
}

@if (busy)
{
    <div class="overlay" role="status" aria-live="polite">
        <div class="overlay-card">
            <LogoMark Size="56" Class="pulse" />
            <div class="overlay-title">Cruzando as planilhas</div>
            <div class="overlay-text">@progress</div>
            <div class="bar-indet"><span></span></div>
        </div>
    </div>
}

@code {
    private List<IBrowserFile> activityFiles = new();
    private IBrowserFile? usersFile;
    private CoopMatchMode mode = CoopMatchMode.OrigemOuDestino;
    private bool busy;
    private string progress = "";
    private string? error;
    private bool dragA, dragU;

    private bool CanAnalyze => activityFiles.Count > 0 && usersFile != null && !busy;

    private void OnActivityFiles(InputFileChangeEventArgs e)
    {
        error = null;
        activityFiles = e.GetMultipleFiles(50).ToList();
    }

    private void OnUsersFile(InputFileChangeEventArgs e)
    {
        error = null;
        usersFile = e.File;
    }

    private async Task Analyze()
    {
        if (!CanAnalyze) return;
        busy = true;
        error = null;
        progress = "Preparando…";
        StateHasChanged();
        await Task.Delay(30);
        try
        {
            await Session.LoadAsync(activityFiles, usersFile!, new AuditOptions { Mode = mode },
                async (text, _) =>
                {
                    progress = text;
                    StateHasChanged();
                    await Task.Delay(1); // deixa o navegador redesenhar
                });
        }
        catch (Exception ex)
        {
            error = ex is InvalidDataException or ArgumentException or IOException
                ? ex.Message
                : $"Erro inesperado ao ler os arquivos ({ex.GetType().Name}): {ex.Message}";
            Session.Reset();
        }
        finally
        {
            busy = false;
        }
    }

    private void Reset()
    {
        Session.Reset();
        activityFiles = new();
        usersFile = null;
        error = null;
    }
}
