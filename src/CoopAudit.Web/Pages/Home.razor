@page "/"
@inject AuditSession Session

<PageTitle>CoopAudit · Monitor de acessos</PageTitle>

@if (Session.HasResult && !busy)
{
    <Dashboard OnReset="Reset" />
}
else
{
    <section class="hero">
        <div class="hero-text">
            <span class="eyebrow">Auditoria de atuação</span>
            <h1>Quem está atuando em cada cooperativa?</h1>
            <p>
                Envie a planilha de atividades (diária ou mensal) e a planilha de usuários.
                O sistema cruza as duas e mostra, em segundos, se usuários <strong>não autorizados</strong>
                estão trabalhando no volume das cooperativas monitoradas.
            </p>
        </div>
    </section>

    <section class="upload-grid">
        <div class="drop @(dragA ? "drag" : "") @(activityFiles.Count > 0 ? "filled" : "")"
             @ondragenter="() => dragA = true" @ondragleave="() => dragA = false" @ondrop="() => dragA = false">
            <InputFile OnChange="OnActivityFiles" multiple accept=".xlsx" aria-label="Planilha de atividades" />
            <div class="drop-step">1</div>
            <div class="drop-icon">
                <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16v16H4z" /><path d="M4 9h16M4 14h16M10 4v16" /></svg>
            </div>
            <div class="drop-title">Planilha de atividades</div>
            <div class="drop-sub">Diária ou mensal · mesmo layout do compilado (.xlsx)</div>
            @if (activityFiles.Count == 0)
            {
                <div class="drop-cta">Arraste aqui ou <u>clique para escolher</u></div>
                <div class="drop-note">Para juntar vários dias, selecione todos os arquivos de uma vez.</div>
            }
            else
            {
                <ul class="file-list">
                    @foreach (var f in activityFiles)
                    {
                        <li><span class="check">✓</span> @f.Name <span class="muted">· @AuditSession.FormatBytes(f.Size)</span></li>
                    }
                </ul>
                <div class="drop-note">Clique para trocar</div>
            }
        </div>

        <div class="drop @(dragU ? "drag" : "") @(usersFile != null ? "filled" : "")"
             @ondragenter="() => dragU = true" @ondragleave="() => dragU = false" @ondrop="() => dragU = false">
            <InputFile OnChange="OnUsersFile" accept=".xlsx" aria-label="Planilha de usuários" />
            <div class="drop-step">2</div>
            <div class="drop-icon">
                <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="8" r="3.2" /><path d="M3 19c.8-3.2 3.2-5 6-5s5.2 1.8 6 5" /><path d="M16 11l2 2 3.5-3.5" /></svg>
            </div>
            <div class="drop-title">Planilha de usuários</div>
            <div class="drop-sub">Abas <code>COOP_autorizados</code> e <code>COOP_não_autorizados</code></div>
            @if (usersFile == null)
            {
                <div class="drop-cta">Arraste aqui ou <u>clique para escolher</u></div>
                <div class="drop-note"><a href="modelos/usuarios_modelo.xlsx" download @onclick:stopPropagation="true">Baixar modelo</a></div>
            }
            else
            {
                <ul class="file-list">
                    <li><span class="check">✓</span> @usersFile.Name <span class="muted">· @AuditSession.FormatBytes(usersFile.Size)</span></li>
                </ul>
                <div class="drop-note">Clique para trocar</div>
            }
        </div>
    </section>

    <section class="setup card">
        <div class="setup-row">
            <div>
                <div class="field-label">Como identificar a cooperativa da atividade</div>
                <div class="segmented">
                    @foreach (var m in Enum.GetValues<CoopMatchMode>())
                    {
                        <button class="@(mode == m ? "on" : "")" @onclick="() => mode = m">@Fmt.ModeLabel(m)</button>
                    }
                </div>
                <div class="field-help">
                    Usa as colunas <code>INSTITUICAOORIGEM</code> e/ou <code>INSTITUICADESTINO</code>. Pode ser alterado depois, no painel.
                </div>
            </div>
            <label class="toggle">
                <input type="checkbox" @bind="strict" />
                <span class="track"><span class="thumb"></span></span>
                <span>
                    <span class="field-label">Modo rigoroso</span>
                    <span class="field-help">Usuários fora das duas listas também contam como irregulares.</span>
                </span>
            </label>
        </div>
        <div class="setup-actions">
            @if (error != null)
            {
                <div class="error-box" role="alert">
                    <strong>Não foi possível analisar.</strong> @error
                </div>
            }
            <button class="btn primary big" disabled="@(!CanAnalyze)" @onclick="Analyze">
                Analisar planilhas
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
            </button>
        </div>
    </section>

    <section class="howto">
        <h3>Como montar a planilha de usuários</h3>
        <div class="howto-grid">
            <div class="howto-item">
                <div class="howto-n">A</div>
                <div>
                    <strong>Uma aba por lista</strong>, com o código da cooperativa no nome:
                    <div class="tabs-demo">
                        <span>3069_autorizados</span><span>3069_não_autorizados</span><span>0300_autorizados</span>
                    </div>
                    Na coluna A, um login por linha (ex.: <code>laisa.caetano</code>). Maiúsculas, acentos e zeros à esquerda são ignorados.
                </div>
            </div>
            <div class="howto-item">
                <div class="howto-n">B</div>
                <div>
                    <strong>Ou uma aba única</strong> com as colunas <code>COOPERATIVA</code>, <code>USUARIO</code> e <code>STATUS</code>
                    (<em>Autorizado</em> / <em>Não autorizado</em>).
                </div>
            </div>
            <div class="howto-item">
                <div class="howto-n">C</div>
                <div>
                    <strong>Classificação:</strong>
                    <span class="badge ok"><StatusIcon Status="AccessStatus.Autorizado" /> Autorizado</span> está na lista de liberados;
                    <span class="badge bad"><StatusIcon Status="AccessStatus.NaoAutorizado" /> Não autorizado</span> está na lista de bloqueados;
                    <span class="badge warn"><StatusIcon Status="AccessStatus.NaoCadastrado" /> Não cadastrado</span> não está em nenhuma.
                </div>
            </div>
        </div>
    </section>
}

@if (busy)
{
    <div class="overlay" role="status" aria-live="polite">
        <div class="overlay-card">
            <div class="spinner"></div>
            <div class="overlay-title">Analisando…</div>
            <div class="overlay-text">@progress</div>
            <div class="bar-indet"><span></span></div>
        </div>
    </div>
}

@code {
    private List<IBrowserFile> activityFiles = new();
    private IBrowserFile? usersFile;
    private CoopMatchMode mode = CoopMatchMode.OrigemOuDestino;
    private bool strict;
    private bool busy;
    private string progress = "";
    private string? error;
    private bool dragA, dragU;

    private bool CanAnalyze => activityFiles.Count > 0 && usersFile != null && !busy;

    private void OnActivityFiles(InputFileChangeEventArgs e)
    {
        error = null;
        activityFiles = e.GetMultipleFiles(50).ToList();
    }

    private void OnUsersFile(InputFileChangeEventArgs e)
    {
        error = null;
        usersFile = e.File;
    }

    private async Task Analyze()
    {
        if (!CanAnalyze) return;
        busy = true;
        error = null;
        progress = "Preparando…";
        StateHasChanged();
        await Task.Delay(30);
        try
        {
            await Session.LoadAsync(activityFiles, usersFile!, new AuditOptions { Mode = mode, UnlistedIsIrregular = strict },
                async (text, _) =>
                {
                    progress = text;
                    StateHasChanged();
                    await Task.Delay(1); // deixa o navegador redesenhar
                });
        }
        catch (Exception ex)
        {
            error = ex is InvalidDataException or ArgumentException or IOException
                ? ex.Message
                : $"Erro inesperado ao ler os arquivos ({ex.GetType().Name}): {ex.Message}";
            Session.Reset();
        }
        finally
        {
            busy = false;
        }
    }

    private void Reset()
    {
        Session.Reset();
        activityFiles = new();
        usersFile = null;
        error = null;
    }
}
