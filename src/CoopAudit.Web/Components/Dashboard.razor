@inject AuditSession Session
@inject IJSRuntime JS

@{
    var r = Session.Result!;
    var ds = Session.Dataset!;
    var dir = Session.Directory!;
    var opt = Session.Options;
}

<section class="dash-head">
    <div>
        <h1>Painel de auditoria</h1>
        <div class="dash-meta">
            <span title="@string.Join(", ", ds.Files)"><svg class="mi" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 3H6v18h12V7z"/><path d="M14 3v4h4"/></svg> @(ds.Files.Count == 1 ? ds.Files[0] : $"{ds.Files.Count} arquivos de atividades")</span>
            <span><svg class="mi" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="8" r="3"/><path d="M3 19c.8-3 3.2-5 6-5s5.2 2 6 5"/><path d="M16 5a3 3 0 0 1 0 6M18 14c1.6.6 2.7 2.4 3 5"/></svg> @Session.UsersFileName</span>
            <span><svg class="mi" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="5" width="16" height="16" rx="2"/><path d="M4 10h16M9 3v4M15 3v4"/></svg> @PeriodText(ds)</span>
        </div>
    </div>
    <div class="dash-actions">
        <button class="btn ghost" @onclick="ExportIrregular" disabled="@(r.IrregularHits.Count == 0)">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 4v11M7 10l5 5 5-5M5 20h14" /></svg>
            Exportar irregulares
        </button>
        <button class="btn primary" @onclick="OnReset">Nova análise</button>
    </div>
</section>

@* ---------- Filtros ---------- *@
<section class="filters card">
    <div class="filter">
        <div class="field-label">Cooperativa</div>
        <div class="chips">
            <button class="chip @(opt.CoopFilter == null ? "on" : "")" @onclick='() => Apply(opt with { CoopFilter = null })'>Todas</button>
            @foreach (var c in dir.Coops.Values.OrderBy(c => c.Label))
            {
                var flagged = r.Options.CoopFilter == null && r.Coops.FirstOrDefault(x => x.Coop == c.Coop)?.Irregular > 0;
                <button class="chip @(opt.CoopFilter == c.Coop ? "on" : "")" @onclick="() => Apply(opt with { CoopFilter = c.Coop })">
                    @if (flagged) { <span class="dot bad"></span> }
                    Coop @c.Label
                </button>
            }
        </div>
    </div>
    <div class="filter">
        <div class="field-label">Atividade pertence à coop pela</div>
        <div class="segmented sm">
            @foreach (var m in Enum.GetValues<CoopMatchMode>())
            {
                <button class="@(opt.Mode == m ? "on" : "")" @onclick="() => Apply(opt with { Mode = m })">@Fmt.ModeLabel(m)</button>
            }
        </div>
    </div>
    @if (ds.RowsPerDay.Count > 1)
    {
        <div class="filter">
            <div class="field-label">Período</div>
            <div class="dates">
                <input type="date" value="@DateValue(opt.From)" min="@DateValue(MinDay(ds))" max="@DateValue(MaxDay(ds))" @onchange="e => SetDate(e, true)" />
                <span>até</span>
                <input type="date" value="@DateValue(opt.To)" min="@DateValue(MinDay(ds))" max="@DateValue(MaxDay(ds))" @onchange="e => SetDate(e, false)" />
                @if (opt.From != null || opt.To != null)
                {
                    <button class="btn ghost sm" @onclick='() => Apply(opt with { From = null, To = null })'>Limpar</button>
                }
            </div>
        </div>
    }
    <label class="toggle compact">
        <input type="checkbox" checked="@opt.UnlistedIsIrregular" @onchange="e => Apply(opt with { UnlistedIsIrregular = e.Value is true })" />
        <span class="track"><span class="thumb"></span></span>
        <span>
            <span class="field-label">Modo rigoroso</span>
            <span class="field-help">Não cadastrados = irregulares</span>
        </span>
    </label>
</section>

@* ---------- Alerta ---------- *@
@if (r.IrregularActivities > 0)
{
    <section class="alert bad">
        <div class="alert-icon"><StatusIcon Status="AccessStatus.NaoAutorizado" Size="26" /></div>
        <div>
            <div class="alert-title">
                @Fmt.N(r.IrregularActivities) @(r.IrregularActivities == 1 ? "atividade irregular encontrada" : "atividades irregulares encontradas")
            </div>
            <div class="alert-text">
                @Fmt.N(r.IrregularUsers) @(r.IrregularUsers == 1 ? "usuário atuou" : "usuários atuaram") sem autorização em
                @(string.Join(", ", r.Coops.Where(c => c.Irregular > 0).Select(c => "Coop " + c.Label))).
                @if (r.IrregularHits.Count > 0)
                {
                    <a href="javascript:void(0)" @onclick='() => { tab = "irreg"; }'> Ver ocorrências ↓</a>
                }
            </div>
        </div>
    </section>
}
else
{
    <section class="alert ok">
        <div class="alert-icon"><StatusIcon Status="AccessStatus.Autorizado" Size="26" /></div>
        <div>
            <div class="alert-title">Nenhum usuário não autorizado atuou nas cooperativas monitoradas</div>
            <div class="alert-text">
                @if (r.UnlistedActivities > 0)
                {
                    <span>Atenção: @Fmt.N(r.UnlistedActivities) atividades foram feitas por usuários que não estão em nenhuma lista. Revise o cadastro ou ative o modo rigoroso.</span>
                }
                else
                {
                    <span>Todo o volume foi feito por usuários autorizados.</span>
                }
            </div>
        </div>
    </section>
}

@* ---------- KPIs ---------- *@
<section class="kpis">
    <KpiCard Label="Linhas no arquivo" Value="@Fmt.N(r.FileRows)" Hint="@($"{Fmt.N(r.FileUsers)} usuários · {Fmt.N(ds.AllCoops.Count)} instituições")" />
    <KpiCard Label="Volume nas coops monitoradas" Value="@Fmt.N(r.MonitoredActivities)" Hint="@($"{Fmt.Pct(r.MonitoredActivities, r.FileRows)} do arquivo · {r.Coops.Count} coop(s)")" />
    <KpiCard Label="Atividades irregulares" Value="@Fmt.N(r.IrregularActivities)" Tone="@(r.IrregularActivities > 0 ? "bad" : "ok")"
             Hint="@($"{Fmt.Pct(r.IrregularShare, 2)} do volume monitorado")" />
    <KpiCard Label="Usuários irregulares" Value="@Fmt.N(r.IrregularUsers)" Tone="@(r.IrregularUsers > 0 ? "bad" : "ok")"
             Hint="@($"de {Fmt.N(r.Users.Select(u => u.User).Distinct().Count())} usuários atuando")" />
    <KpiCard Label="Por não cadastrados" Value="@Fmt.N(r.UnlistedActivities)" Tone="@(r.UnlistedActivities > 0 ? "warn" : "")"
             Hint="@($"{Fmt.Pct(r.UnlistedActivities, r.MonitoredActivities)} · fora das listas")" />
</section>

@* ---------- Cooperativas ---------- *@
<section class="section-head">
    <h2>Cooperativas monitoradas</h2>
    <span class="muted">Clique em um card para filtrar o painel</span>
</section>
<section class="coop-grid">
    @foreach (var c in r.Coops)
    {
        <article class="coop-card @(c.Irregular > 0 ? "alarm" : "") @(opt.CoopFilter == c.Coop ? "selected" : "")"
                 @onclick="() => Apply(opt with { CoopFilter = opt.CoopFilter == c.Coop ? null : c.Coop })">
            <header>
                <div class="coop-code">Coop <strong>@c.Label</strong></div>
                @if (c.Irregular > 0)
                {
                    <span class="badge bad"><StatusIcon Status="AccessStatus.NaoAutorizado" /> @Fmt.N(c.Irregular) irregular(es)</span>
                }
                else if (c.Volume.Total == 0)
                {
                    <span class="badge neutral">Sem volume</span>
                }
                else if (c.Volume.NaoCadastrado > 0)
                {
                    <span class="badge warn" title="Sem usuários bloqueados atuando, mas há volume de usuários fora das listas">
                        <StatusIcon Status="AccessStatus.NaoCadastrado" /> @Fmt.Pct(c.Volume.NaoCadastrado, c.Volume.Total, 0) fora das listas
                    </span>
                }
                else
                {
                    <span class="badge ok"><StatusIcon Status="AccessStatus.Autorizado" /> Regular</span>
                }
            </header>
            <div class="coop-stats">
                <div><span class="num">@Fmt.N(c.Volume.Total)</span><span class="lbl">atividades</span></div>
                <div><span class="num">@Fmt.N(c.UsersActing)</span><span class="lbl">usuários atuando</span></div>
                <div><span class="num">@c.AuthorizedActing/@c.ListedAuthorized</span><span class="lbl">autorizados ativos</span></div>
                <div><span class="num">@c.ListedUnauthorized</span><span class="lbl">bloqueados na lista</span></div>
            </div>
            <StackBar Counts="c.Volume" Height="12" />
            <div class="coop-legend">
                <span><i class="sw ok"></i>@Fmt.N(c.Volume.Autorizado) autorizado</span>
                <span><i class="sw warn"></i>@Fmt.N(c.Volume.NaoCadastrado) não cadastrado</span>
                <span><i class="sw bad"></i>@Fmt.N(c.Volume.NaoAutorizado) não autorizado</span>
            </div>
            @if (c.FlaggedUsers.Count > 0)
            {
                <div class="flagged">
                    @foreach (var u in c.FlaggedUsers.Take(6))
                    {
                        <span class="pill @Fmt.StatusCss(u.Status)" title="@Fmt.StatusLabel(u.Status) · última atuação @Fmt.DateTime(u.Last)">
                            <StatusIcon Status="u.Status" Size="12" /> @u.User <b>@Fmt.N(u.Count)</b>
                        </span>
                    }
                    @if (c.FlaggedUsers.Count > 6)
                    {
                        <span class="pill more">+@(c.FlaggedUsers.Count - 6)</span>
                    }
                </div>
            }
        </article>
    }
</section>

@* ---------- Gráficos ---------- *@
<section class="grid-2-1">
    <div class="card">
        <div class="card-head">
            <h3>Volume @(r.TimelineIsHourly ? "por hora" : "por dia")</h3>
            <div class="legend-inline">
                <span><i class="sw ok"></i>Autorizado</span>
                <span><i class="sw warn"></i>Não cadastrado</span>
                <span><i class="sw bad"></i>Não autorizado</span>
            </div>
        </div>
        <TimelineChart Buckets="r.Timeline" />
    </div>
    <div class="card">
        <div class="card-head"><h3>Situação do volume</h3></div>
        <Donut Counts="r.StatusTotals" CenterValue="@Fmt.N(r.StatusTotals.Total)" CenterLabel="atividades" />
        @if (opt.Mode == CoopMatchMode.OrigemOuDestino && r.StatusTotals.Total != r.MonitoredActivities)
        {
            <p class="footnote">Atividades entre duas coops monitoradas contam uma vez para cada coop.</p>
        }
    </div>
</section>

<section class="grid-1-1">
    <div class="card">
        <div class="card-head">
            <h3>Usuários com mais volume</h3>
            <span class="muted">top 12 · cor = situação</span>
        </div>
        @{
            var top = r.Users.OrderByDescending(u => u.Count).Take(12).ToList();
            var maxU = top.Count > 0 ? top.Max(u => u.Count) : 1;
        }
        @if (top.Count == 0)
        {
            <div class="empty small">Sem atividades no filtro atual.</div>
        }
        <ul class="hbars">
            @foreach (var u in top)
            {
                <li data-tip="@u.User · Coop @CoopLabel(u.Coop) · @Fmt.StatusLabel(u.Status) · @Fmt.N(u.Count) atividades">
                    <span class="hb-label"><StatusIcon Status="u.Status" Size="12" /> @u.User <span class="muted">· @CoopLabel(u.Coop)</span></span>
                    <span class="hb-track"><span class="hb-bar @Fmt.StatusCss(u.Status)" style="width:@(Pc(u.Count, maxU))%"></span></span>
                    <span class="hb-val">@Fmt.N(u.Count)</span>
                </li>
            }
        </ul>
    </div>
    <div class="card">
        <div class="card-head">
            <h3>O que foi feito nas atividades irregulares</h3>
        </div>
        @if (r.IrregularProcedures.Count == 0)
        {
            <div class="empty small">
                <StatusIcon Status="AccessStatus.Autorizado" Size="22" />
                <div>Nenhuma atividade irregular no filtro atual.</div>
            </div>
        }
        else
        {
            var maxP = r.IrregularProcedures.Max(p => p.Count);
            <div class="field-label">Procedimento</div>
            <ul class="hbars">
                @foreach (var p in r.IrregularProcedures.Take(8))
                {
                    <li data-tip="@p.Name: @Fmt.N(p.Count)">
                        <span class="hb-label">@p.Name</span>
                        <span class="hb-track"><span class="hb-bar bad" style="width:@(Pc(p.Count, maxP))%"></span></span>
                        <span class="hb-val">@Fmt.N(p.Count)</span>
                    </li>
                }
            </ul>
            var maxQ = r.IrregularProcesses.Max(p => p.Count);
            <div class="field-label" style="margin-top:14px">Processo</div>
            <ul class="hbars">
                @foreach (var p in r.IrregularProcesses.Take(5))
                {
                    <li data-tip="@p.Name: @Fmt.N(p.Count)">
                        <span class="hb-label">@p.Name</span>
                        <span class="hb-track"><span class="hb-bar bad" style="width:@(Pc(p.Count, maxQ))%"></span></span>
                        <span class="hb-val">@Fmt.N(p.Count)</span>
                    </li>
                }
            </ul>
        }
    </div>
</section>

@* ---------- Tabelas ---------- *@
<section class="card tables" id="detalhes">
    <div class="tabs">
        <button class="@(tab == "irreg" ? "on" : "")" @onclick='() => { tab = "irreg"; page = 0; }'>
            Ocorrências irregulares <span class="count bad">@Fmt.N(r.IrregularHits.Count)</span>
        </button>
        <button class="@(tab == "users" ? "on" : "")" @onclick='() => { tab = "users"; page = 0; }'>
            Usuários por cooperativa <span class="count">@Fmt.N(r.Users.Count)</span>
        </button>
        <button class="@(tab == "lists" ? "on" : "")" @onclick='() => { tab = "lists"; page = 0; }'>
            Listas cadastradas
        </button>
        @if (dir.Warnings.Count + ds.Warnings.Count > 0 || ds.DuplicateRows > 0)
        {
            <button class="@(tab == "warn" ? "on" : "")" @onclick='() => { tab = "warn"; page = 0; }'>
                Avisos <span class="count warn">@(dir.Warnings.Count + ds.Warnings.Count + (ds.DuplicateRows > 0 ? 1 : 0))</span>
            </button>
        }
    </div>

    @if (tab == "irreg")
    {
        var rows = r.IrregularHits.Where(MatchHit).ToList();
        <div class="table-tools">
            <input class="search" placeholder="Buscar usuário, registro, CPF/CNPJ na justificativa…" value="@search" @oninput="e => { search = e.Value?.ToString() ?? string.Empty; page = 0; }" />
            <button class="btn ghost sm" @onclick="ExportIrregular" disabled="@(rows.Count == 0)">Exportar CSV</button>
        </div>
        @if (rows.Count == 0)
        {
            <div class="empty">
                @(r.IrregularHits.Count == 0 ? "Nenhuma ocorrência irregular. 🎉" : "Nada encontrado para essa busca.")
            </div>
        }
        else
        {
            <div class="table-wrap">
                <table>
                    <thead>
                        <tr>
                            <th>Data/hora</th><th>Coop</th><th>Usuário</th><th>Situação</th><th>Atividade</th>
                            <th>Procedimento</th><th>Origem → Destino</th><th>Registro</th><th>Justificativa</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var h in rows.Skip(page * PageSize).Take(PageSize))
                        {
                            var a = h.Activity;
                            <tr>
                                <td class="nowrap">@Fmt.DateTime(a.When)</td>
                                <td><strong>@CoopLabel(h.Coop)</strong></td>
                                <td class="nowrap mono">@a.User</td>
                                <td><StatusBadge Status="h.Status" Irregular="h.Irregular" /></td>
                                <td>@a.ActivityName</td>
                                <td>@a.Procedure</td>
                                <td class="nowrap">@a.OriginCoop/@a.OriginUnit → @a.DestCoop/@a.DestUnit</td>
                                <td class="mono small">@a.RecordId</td>
                                <td class="just" title="@a.Justification">@a.Justification</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <Pager Total="rows.Count" PageSize="PageSize" Page="page" PageChanged="p => page = p" />
        }
    }
    else if (tab == "users")
    {
        var coopTotals = r.Coops.ToDictionary(c => c.Coop, c => c.Volume.Total);
        var rows = r.Users.Where(MatchUser).ToList();
        <div class="table-tools">
            <input class="search" placeholder="Buscar usuário…" value="@search" @oninput="e => { search = e.Value?.ToString() ?? string.Empty; page = 0; }" />
            <div class="segmented sm">
                <button class="@(statusFilter == null ? "on" : "")" @onclick="() => { statusFilter = null; page = 0; }">Todos</button>
                @foreach (var s in new[] { AccessStatus.NaoAutorizado, AccessStatus.NaoCadastrado, AccessStatus.Autorizado })
                {
                    <button class="@(statusFilter == s ? "on" : "")" @onclick="() => { statusFilter = s; page = 0; }">@Fmt.StatusLabel(s)</button>
                }
            </div>
            <button class="btn ghost sm" @onclick="() => ExportUsers(rows)" disabled="@(rows.Count == 0)">Exportar CSV</button>
        </div>
        @if (rows.Count == 0)
        {
            <div class="empty">Nenhum usuário nesse filtro.</div>
        }
        else
        {
            <div class="table-wrap">
                <table>
                    <thead>
                        <tr>
                            <th>Coop</th><th>Usuário</th><th>Situação</th><th class="r">Atividades</th><th>% do volume da coop</th>
                            <th>Primeira</th><th>Última</th><th>Procedimento mais comum</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var u in rows.Skip(page * PageSize).Take(PageSize))
                        {
                            var tot = coopTotals.GetValueOrDefault(u.Coop);
                            <tr class="@(u.Irregular ? "row-flag" : "")">
                                <td><strong>@CoopLabel(u.Coop)</strong></td>
                                <td class="mono">@u.User</td>
                                <td><StatusBadge Status="u.Status" Irregular="u.Irregular" /></td>
                                <td class="r">@Fmt.N(u.Count)</td>
                                <td>
                                    <div class="mini">
                                        <span class="mini-track"><span class="mini-bar @Fmt.StatusCss(u.Status)" style="width:@(Pc(u.Count, tot))%"></span></span>
                                        <span>@Fmt.Pct(u.Count, tot)</span>
                                    </div>
                                </td>
                                <td class="nowrap">@Fmt.DateTime(u.First)</td>
                                <td class="nowrap">@Fmt.DateTime(u.Last)</td>
                                <td>@u.TopProcedure</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <Pager Total="rows.Count" PageSize="PageSize" Page="page" PageChanged="p => page = p" />
        }
    }
    else if (tab == "lists")
    {
        var acting = r.Users.GroupBy(u => u.Coop).ToDictionary(g => g.Key, g => g.ToDictionary(u => u.User, u => u.Count));
        <div class="lists-grid">
            @foreach (var c in dir.Coops.Values.OrderBy(c => c.Label))
            {
                var act = acting.GetValueOrDefault(c.Coop) ?? new();
                <div class="list-card">
                    <h4>Coop @c.Label</h4>
                    <div class="list-cols">
                        <div>
                            <div class="field-label"><StatusIcon Status="AccessStatus.Autorizado" /> Autorizados (@c.Authorized.Count)</div>
                            @if (c.Authorized.Count == 0) { <div class="muted small">Lista vazia</div> }
                            <ul>
                                @foreach (var u in c.Authorized.OrderBy(x => x))
                                {
                                    <li><span class="mono">@u</span> <span class="muted">@(act.TryGetValue(u, out var n) ? $"{Fmt.N(n)} ativ." : "sem atuação")</span></li>
                                }
                            </ul>
                        </div>
                        <div>
                            <div class="field-label"><StatusIcon Status="AccessStatus.NaoAutorizado" /> Não autorizados (@c.Unauthorized.Count)</div>
                            @if (c.Unauthorized.Count == 0) { <div class="muted small">Lista vazia</div> }
                            <ul>
                                @foreach (var u in c.Unauthorized.OrderBy(x => x))
                                {
                                    var hasAct = act.TryGetValue(u, out var n);
                                    <li class="@(hasAct ? "hot" : "")"><span class="mono">@u</span> <span class="@(hasAct ? "txt-bad" : "muted")">@(hasAct ? $"atuou {Fmt.N(n)}×" : "não atuou")</span></li>
                                }
                            </ul>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <ul class="warnings">
            @foreach (var w in dir.Warnings.Concat(ds.Warnings))
            {
                <li>⚠ @w</li>
            }
            @if (ds.DuplicateRows > 0)
            {
                <li>⚠ @Fmt.N(ds.DuplicateRows) linhas repetidas entre os arquivos foram ignoradas.</li>
            }
        </ul>
    }
</section>

@code {
    [Parameter] public EventCallback OnReset { get; set; }

    private const int PageSize = 20;
    private string tab = "irreg";
    private int page;
    private string search = "";
    private AccessStatus? statusFilter;

    private void Apply(AuditOptions o)
    {
        Session.Reanalyze(o);
        page = 0;
    }

    private void SetDate(ChangeEventArgs e, bool from)
    {
        DateOnly? d = DateOnly.TryParseExact(e.Value?.ToString(), "yyyy-MM-dd", out var v) ? v : null;
        Apply(from ? Session.Options with { From = d } : Session.Options with { To = d });
    }

    private string CoopLabel(string coop) =>
        Session.Directory!.Coops.TryGetValue(coop, out var c) ? c.Label : coop;

    private static string Pc(int v, int max) =>
        (max == 0 ? 0 : Math.Max(1.5, 100.0 * v / max)).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);

    private static DateOnly? MinDay(ActivityDataset ds) => ds.RowsPerDay.Count == 0 ? null : ds.RowsPerDay.Keys.Min();
    private static DateOnly? MaxDay(ActivityDataset ds) => ds.RowsPerDay.Count == 0 ? null : ds.RowsPerDay.Keys.Max();
    private static string DateValue(DateOnly? d) => d?.ToString("yyyy-MM-dd") ?? "";

    private string PeriodText(ActivityDataset ds)
    {
        var min = MinDay(ds);
        var max = MaxDay(ds);
        if (min is null) return "período não identificado";
        var baseText = min == max ? min.Value.ToString("dd/MM/yyyy") : $"{min:dd/MM/yyyy} a {max:dd/MM/yyyy} ({ds.RowsPerDay.Count} dias)";
        var o = Session.Options;
        if (o.From != null || o.To != null)
            baseText += $" · filtro: {(o.From ?? min):dd/MM} – {(o.To ?? max):dd/MM}";
        return baseText;
    }

    private bool MatchHit(Hit h)
    {
        if (string.IsNullOrWhiteSpace(search)) return true;
        var q = search.Trim();
        var a = h.Activity;
        return a.User.Contains(q, StringComparison.OrdinalIgnoreCase)
            || a.RecordId.Contains(q, StringComparison.OrdinalIgnoreCase)
            || a.OccurrenceId.Contains(q, StringComparison.OrdinalIgnoreCase)
            || a.Justification.Contains(q, StringComparison.OrdinalIgnoreCase)
            || a.Procedure.Contains(q, StringComparison.OrdinalIgnoreCase);
    }

    private bool MatchUser(UserSummary u) =>
        (statusFilter == null || u.Status == statusFilter) &&
        (string.IsNullOrWhiteSpace(search) || u.User.Contains(search.Trim(), StringComparison.OrdinalIgnoreCase));

    private async Task ExportIrregular()
    {
        var r = Session.Result!;
        var csv = Fmt.Csv(
            ["DATA/HORA", "COOP", "USUARIO", "SITUACAO", "IDPROCESSO", "NOMEPROCESSO", "IDOCORRENCIAPROCESSO", "IDREGISTROCONTROLADO",
             "INSTITUICAOORIGEM", "UNIDADEORIGEM", "INSTITUICADESTINO", "UNIDADEDESTINO", "ATIVIDADE", "PROCEDIMENTO", "SITUACAOFLUXO",
             "DATAHORAINICIOATIVIDADE", "DATAHORAFIMATIVIDADE", "JUSTIFICATIVA", "ARQUIVO", "LINHA"],
            r.IrregularHits.Where(MatchHit).Select(h =>
            {
                var a = h.Activity;
                return new string?[]
                {
                    Fmt.DateTime(a.When), CoopLabel(h.Coop), a.User, Fmt.StatusLabel(h.Status), a.ProcessId, a.ProcessName, a.OccurrenceId, a.RecordId,
                    a.OriginCoop, a.OriginUnit, a.DestCoop, a.DestUnit, a.ActivityName, a.Procedure, a.FlowStatus,
                    a.Start?.ToString("dd/MM/yyyy HH:mm:ss"), a.End?.ToString("dd/MM/yyyy HH:mm:ss"), a.Justification, a.Source, a.Line.ToString()
                };
            }));
        await JS.InvokeVoidAsync("coopAudit.download", $"ocorrencias_irregulares_{DateTime.Now:yyyyMMdd_HHmm}.csv", csv);
    }

    private async Task ExportUsers(List<UserSummary> rows)
    {
        var csv = Fmt.Csv(
            ["COOP", "USUARIO", "SITUACAO", "IRREGULAR", "ATIVIDADES", "PRIMEIRA", "ULTIMA", "PROCEDIMENTO_MAIS_COMUM"],
            rows.Select(u => new string?[]
            {
                CoopLabel(u.Coop), u.User, Fmt.StatusLabel(u.Status), u.Irregular ? "SIM" : "NAO", u.Count.ToString(),
                Fmt.DateTime(u.First), Fmt.DateTime(u.Last), u.TopProcedure
            }));
        await JS.InvokeVoidAsync("coopAudit.download", $"usuarios_por_coop_{DateTime.Now:yyyyMMdd_HHmm}.csv", csv);
    }
}
